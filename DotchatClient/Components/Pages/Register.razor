@page "/register"

@using DotchatClient.src.Core
@inject IJSRuntime JS

<link rel="stylesheet" href="css/login.css" />

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body, html {
        height: 100%;
        background: #1a1a1f;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1a1a1f;
        padding: 2rem;
    }

    .card {
        background: #222228;
        border: 0.5px solid #333340;
        border-radius: 16px;
        padding: 40px;
        width: 100%;
        max-width: 380px;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 32px;
    }

    .logo-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #7c6af7, #6a59e0);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(124, 106, 247, 0.35);
        flex-shrink: 0;
    }

    .logo-img {
        filter: brightness(0) invert(1);
        display: block;
    }

    .logo-text {
        color: #fff;
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.3px;
    }

    h2 {
        color: #f0f0f5;
        font-size: 20px;
        font-weight: 500;
        margin-bottom: 6px;
    }

    .subtitle {
        color: #6b6b80;
        font-size: 14px;
        margin-bottom: 28px;
    }

    .error-banner {
        background: rgba(226, 75, 74, 0.1);
        border: 0.5px solid rgba(226, 75, 74, 0.3);
        color: #f08080;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .field {
        margin-bottom: 16px;
    }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 6px;
    }

    label {
        display: block;
        color: #9090a8;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .char-count {
        color: #3a3a50;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0;
        font-variant-numeric: tabular-nums;
    }

        .char-count.near-limit {
            color: #d9a441;
        }

        .char-count.at-limit {
            color: #f08080;
        }

    .input-wrap {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #555568;
        pointer-events: none;
    }

        .input-icon img {
            display: block;
            width: 16px;
            height: 16px;
        }

    input[type="email"], input[type="password"], input[type="text"], input[type="date"] {
        width: 100%;
        background: #16161c;
        border: 0.5px solid #333340;
        border-radius: 8px;
        padding: 11px 40px;
        color: #f0f0f5;
        font-size: 14px;
        outline: none;
        transition: border-color 0.15s;
    }

    input[type="date"] {
        padding: 11px 12px 11px 40px;
        color-scheme: dark;
    }

    textarea {
        width: 100%;
        background: #16161c;
        border: 0.5px solid #333340;
        border-radius: 8px;
        padding: 11px 12px;
        color: #f0f0f5;
        font-size: 14px;
        outline: none;
        resize: none;
        field-sizing: content;
        max-height: 200px;
        overflow-y: auto;
        min-height: 64px;
        font-family: inherit;
        transition: border-color 0.15s;
    }

    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }

    input:focus, textarea:focus {
        border-color: #7c6af7;
    }

    input::placeholder, textarea::placeholder {
        color: #3a3a50;
    }

    .pw-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #555568;
        padding: 4px;
        border-radius: 4px;
        font-size: 16px;
        line-height: 1;
        transition: color 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pw-toggle:hover {
            color: #9090a8;
        }

        .pw-toggle img {
            display: block;
            width: 16px;
            height: 16px;
            opacity: 0.6;
            transition: opacity 0.15s;
        }

        .pw-toggle:hover img {
            opacity: 1;
        }

    .optional-tag {
        color: #3a3a50;
        font-weight: 400;
        text-transform: none;
        letter-spacing: 0;
    }

    .btn-primary {
        width: 100%;
        background: #7c6af7;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.15s, transform 0.1s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-primary:hover:not(:disabled) {
            background: #6a59e0;
        }

        .btn-primary:active:not(:disabled) {
            transform: scale(0.99);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-ghost:active:not(:disabled) {
        transform: scale(0.99);
    }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0;
        color: #3a3a50;
        font-size: 12px;
    }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            height: 0.5px;
            background: #333340;
        }

    .btn-ghost {
        width: 100%;
        background: transparent;
        color: #9090a8;
        border: 0.5px solid #333340;
        border-radius: 8px;
        padding: 11px;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: border-color 0.15s, color 0.15s;
    }

        .btn-ghost:hover {
            border-color: #555568;
            color: #f0f0f5;
        }

    .login-link {
        text-align: center;
        margin-top: 20px;
        color: #6b6b80;
        font-size: 13px;
    }

        .login-link a {
            color: #7c6af7;
            text-decoration: none;
            font-weight: 500;
        }
</style>

<div class="wrap">
    <div class="card">

        <div class="logo">
            <div class="logo-icon">
                <img src="@DotchatSvg" alt="Dotchat" width="22" height="22" class="logo-img" style="border-radius: 5px" />
            </div>
            <span class="logo-text">Dotchat</span>
        </div>

        <h2>Konto erstellen</h2>
        <p class="subtitle">Registriere dich, um Dotchat zu nutzen.</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-banner">@ErrorMessage</div>
        }

        <div class="field">
            <label>E-MAIL</label>
            <div class="input-wrap">
                <span class="input-icon">✉</span>
                <input type="email" @bind="Email" @bind:event="oninput" placeholder="du@example.com" />
            </div>
        </div>

        <div class="field">
            <label>PASSWORT</label>
            <div class="input-wrap">
                <span class="input-icon">🔒</span>
                <input type="@(ShowPassword ? "text" : "password")"
                       @bind="Password"
                       @bind:event="oninput"
                       placeholder="********" />
                <button class="pw-toggle" @onclick="() => ShowPassword = !ShowPassword">
                    <img src="@(ShowPassword ? ClosedEyeSvg : EyeSvg)" alt="Passwort anzeigen" width="16" height="16" />
                </button>
            </div>
        </div>

        <div class="field">
            <div class="label-row">
                <label>USERNAME</label>
                <span class="char-count @GetCountClass(Username.Length, MaxUsernameLength)">@Username.Length/@MaxUsernameLength</span>
            </div>
            <div class="input-wrap">
                <span class="input-icon">@@</span>
                <input type="text" @bind="Username" @bind:event="oninput" maxlength="@MaxUsernameLength" placeholder="username" />
            </div>
        </div>

        <div class="field">
            <div class="label-row">
                <label>ANZEIGENAME</label>
                <span class="char-count @GetCountClass(DisplayName.Length, MaxDisplayNameLength)">@DisplayName.Length/@MaxDisplayNameLength</span>
            </div>
            <div class="input-wrap">
                <span class="input-icon">👤</span>
                <input type="text" @bind="DisplayName" @bind:event="oninput" maxlength="@MaxDisplayNameLength" placeholder="Cris" />
            </div>
        </div>

        <div class="field">
            <label>GEBURTSTAG</label>
            <div class="input-wrap">
                <span class="input-icon">🎂</span>
                <input type="date"
                       @ref="_birthdayInput"
                       @bind="Birthday"
                       @bind:event="oninput"
                       min="1900-01-01"
                       max="@_today" />
            </div>
        </div>

        <div class="field">
            <div class="label-row">
                <label>BIO <span class="optional-tag">(optional)</span></label>
                <span class="char-count @GetCountClass(Bio.Length, MaxBioLength)">@Bio.Length/@MaxBioLength</span>
            </div>
            <textarea @bind="Bio" @bind:event="oninput" maxlength="@MaxBioLength" placeholder="Erzähl was über dich..."></textarea>
        </div>

        <button class="btn-primary" @onclick="HandleRegisterAsync" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner"></span>
            }
            else
            {
                <span>Registrieren</span>
            }
        </button>

        <div class="divider">oder</div>

        <button class="btn-ghost" style="margin: 10px 0px">
            <span>
                <img src="@GitHubSvg" alt="GitHub" height="25" width="25" />
            </span>
            Mit GitHub fortfahren
        </button>

        <button class="btn-ghost" style="margin: 10px 0px">
            <span>
                <img src="@GoogleSvg" alt="Google" height="25" width="25" />
            </span>
            Mit Google fortfahren
        </button>

        <p class="login-link">
            Schon ein Konto? <a href="/login">Anmelden</a>
        </p>
    </div>
</div>